# Copie para .env.local (fica fora do git). Só preencha o que for usar.
# Somente os arquivos .env e .env.local da raiz do flow-reel são lidos.

# Conferência da fala (OpenAI) e timestamps por palavra (Groq), respectivamente
OPENAI_API_KEY=
GROQ_API_KEY=

# Troca pela voz clonada (módulo opcional)
# Precisa da permissão "Speech to Speech"
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Fundo único gerado por IA (só se pedir fundo único)
OPENROUTER_API_KEY=

# Publicação no Instagram (módulo opcional)
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Hospedagem privada temporária (opcional; veja references/supabase-storage.sql)
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL também é aceito para compatibilidade.
SUPABASE_PUBLISHABLE_KEY=
# Refresh token inicial do usuário dedicado, limitado por RLS.
# A sessão é renovada antes de cada upload; a rotação fica em .supabase-session.json.
SUPABASE_STORAGE_REFRESH_TOKEN=
# Opcional: JWT de acesso da sessão inicial para conferir o usuário esperado.
# Não use service_role nem sb_secret_. Não precisa atualizar o JWT manualmente.
SUPABASE_STORAGE_ACCESS_TOKEN=
SUPABASE_STORAGE_BUCKET=flow-reel-media
# Segundos de acesso para a API baixar a mídia (6 horas; máximo 7 dias).
SUPABASE_SIGNED_URL_TTL=21600

# Corte com auto-editor (opcional; vazio usa executável no PATH)
AUTO_EDITOR_PATH=

# Publicação no LinkedIn (módulo opcional; token vale ~60 dias)
LINKEDIN_ACCESS_TOKEN=
