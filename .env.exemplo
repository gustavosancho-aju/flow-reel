# Copie para .env.local (fica fora do git). Só preencha o que for usar.

# Transcrição (use uma das duas)
OPENAI_API_KEY=
GROQ_API_KEY=

# Troca pela voz clonada (módulo opcional)
ELEVENLABS_API_KEY=        # precisa da permissão "Speech to Speech"
ELEVENLABS_VOICE_ID=

# Fundo único gerado por IA (só se pedir fundo único)
OPENROUTER_API_KEY=

# Publicação no Instagram (módulo opcional)
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Hospedagem temporária do vídeo/capa para a API do Instagram (módulo opcional)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publicação no LinkedIn (módulo opcional; token vale ~60 dias)
LINKEDIN_ACCESS_TOKEN=
